# Postgres connection string (Neon or local)
DATABASE_URL=

# Clerk — https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Cloudinary — https://cloudinary.com (free tier is enough for uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pollinations — free key from https://enter.pollinations.ai/keys
# Use a secret key (sk_...). New accounts receive free Pollen for image and video calls.
# Image fusion uses FLUX.1 (multi-image). Video uses Veo (image-to-video).
POLLINATIONS_API_KEY=
# POLLINATIONS_IMAGE_MODEL=flux
# Video uses Veo with speech. Allowed lengths are 4, 6, or 8 seconds.
# POLLINATIONS_VIDEO_MODEL=veo

# Sentry (optional error reporting)
SENTRY_DSN=

PORT=5000
# Comma-separated allowed frontend origins (defaults to localhost:5173 / 4173 in local dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Reverse proxy hop count for rate limiting (leave unset/0 in local dev; set to 1 on Render/Railway/Nginx)
# TRUST_PROXY_HOPS=1
