# Postgres connection string (Neon or local)
DATABASE_URL=

# Clerk — https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Cloudinary — https://cloudinary.com (free tier is enough for uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pollinations — free key from https://enter.pollinations.ai/keys
# Use a secret key (sk_...). New accounts receive free Pollen for image and video calls.
# Image fusion uses FLUX.2 Klein (multi-image). Video uses Wan 2.2 Fast (image-to-video).
POLLINATIONS_API_KEY=
# POLLINATIONS_IMAGE_MODEL=klein
# Video uses Veo with speech. Allowed lengths are 4, 6, or 8 seconds.
# POLLINATIONS_VIDEO_MODEL=veo

PORT=5000
