# Postgres connection string (Neon or local)
DATABASE_URL=

# Clerk — https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Cloudinary — https://cloudinary.com (free tier is enough for uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini — free vision is used to describe product + model photos.
# Native Nano Banana image generation needs AI Studio billing, so it is off by default.
GEMINI_API_KEY=
# GEMINI_TRY_IMAGE=1
# GEMINI_VISION_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview

# Hugging Face — used for product + model stills (FLUX Kontext)
# Free token, no billing: https://huggingface.co/settings/tokens
# Also accept the FLUX.1-Kontext-dev license on the model page.
HF_TOKEN=
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-Kontext-dev

# Sentry (optional error reporting)
SENTRY_DSN=

PORT=5000
# Comma-separated allowed frontend origins (defaults to localhost:5173 / 4173 in local dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Reverse proxy hop count for rate limiting (leave unset/0 in local dev; set to 1 on Render/Railway/Nginx)
# TRUST_PROXY_HOPS=1
