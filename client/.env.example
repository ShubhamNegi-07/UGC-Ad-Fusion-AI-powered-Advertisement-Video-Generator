# Clerk publishable key — https://dashboard.clerk.com
# Production (Vercel): set this in Project → Settings → Environment Variables (Production).
# Vite inlines VITE_* at build time — changing it later requires a Redeploy.
VITE_CLERK_PUBLISHABLE_KEY=

# API origin. Defaults to http://localhost:5000 when unset.
# Production (Vercel): https://your-api.onrender.com  (no trailing slash)
VITE_BASEURL=http://localhost:5000
